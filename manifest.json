{
  "manifest_version": 3,
  "name": "PlaceFit Companion",
  "version": "0.2.0",
  "description": "Painel lateral do CRM PlaceFit no WhatsApp Web.",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://app.placefit.com.br/*"],
  "externally_connectable": {"matches":["https://app.placefit.com.br/*","https://placefit.base44.app/*"]},
  "background": {"service_worker":"background.js"},
  "action": {"default_title":"Abrir PlaceFit Companion"},
  "content_scripts": [{"matches":["https://web.whatsapp.com/*"],"js":["content.js"],"run_at":"document_idle"}],
  "side_panel": {"default_path":"sidebar.html"}
}